# Visual.Cineaste — Environment Variables
# Copy this file to .env and fill in your values

# ────────────────────────────────────────────
# TMDB (The Movie Database)
# Create a TMDB API read access token at https://www.themoviedb.org/settings/api
# ────────────────────────────────────────────
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# ────────────────────────────────────────────
# MongoDB
# Get from MongoDB Atlas: https://cloud.mongodb.com
# ────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_STORAGE_LIMIT_BYTES=536870912
MONGO_STORAGE_WARNING_PCTS=60,75,85,90
MONGO_STORAGE_BLOCK_AT_PERCENT=85

# ────────────────────────────────────────────
# JWT — use a long, random, cryptographically secure string
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars

# ────────────────────────────────────────────
# Server
# ────────────────────────────────────────────
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
VITE_API_BASE_URL=

# ────────────────────────────────────────────
# Box Office data ingestion/cache (no provider key required)
# ────────────────────────────────────────────
BOX_OFFICE_SYNC_INTERVAL_HOURS=4
BOX_OFFICE_CACHE_TTL_SECONDS=3600
BOX_OFFICE_REPORT_TTL_DAYS=30
BOX_OFFICE_MAX_DAILY_REPORTS=1000
BOX_OFFICE_MAX_LIFETIME_REPORTS=300

# ────────────────────────────────────────────
# Encrypted MongoDB backups to S3-compatible storage
# Requires MongoDB Database Tools (mongodump) and AWS CLI v2.
# Generate key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_KEY=<base64 32-byte key; keep outside source control>
# S3_BUCKET=<bucket-name>
# S3_PREFIX=cineshelf/backups
# S3_ENDPOINT_URL=<optional S3-compatible endpoint, e.g. R2/B2>
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<secret>
# AWS_SECRET_ACCESS_KEY=<secret>
# MONGODUMP_BINARY_PATH=mongodump
# AWS_CLI_PATH=aws

# ────────────────────────────────────────────
# OpenRouter AI (for movie recommendations)
# Get from: https://openrouter.ai/keys
# ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# ────────────────────────────────────────────
# Email verification (Gmail: use a Google App Password, not your account password)
# Supports any SMTP provider.
# ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=your_email@gmail.com

# Google OAuth web client ID; set the same client ID for server and Vite frontend.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
